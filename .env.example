# MiniPay local configuration. Copy to .env and adjust.
API_KEY=minipay-dev-key
DATABASE_URL=sqlite:///./data/minipay.db
LOG_LEVEL=INFO
# Set true only to reproduce INCIDENT-001 (duplicate ref → HTTP 500).
BUGGY_SEARCH=false
# Optional: used by the L2 support CLI
MINIPAY_API_URL=http://127.0.0.1:8080
MINIPAY_API_KEY=minipay-dev-key
MINIPAY_TIMEOUT_SECONDS=8
